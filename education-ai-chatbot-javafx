/*
 * Common words that are removed during preprocessing.
 */
private void loadStopWords() {

    String[] words = {
        "the", "is", "a", "an", "to", "of", "for",
        "in", "on", "at", "and", "or", "i", "me",
        "my", "you", "your", "can", "could", "would",
        "please", "what", "how", "do", "does", "are",
        "tell", "about"
    };

    stopWords.addAll(Arrays.asList(words));
}

