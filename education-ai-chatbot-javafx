/*
 * Add an intent with its keywords and response.
 */
private void addIntent(
        String intent,
        List<String> intentKeywords,
        String response) {

    keywords.put(intent, intentKeywords);
    responses.put(intent, response);
}

/*
 * Convert text to lowercase and remove punctuation.
 */
private String normalize(String text) {

    return text
            .toLowerCase()
            .replaceAll("[^a-z0-9\\s]", " ")
            .replaceAll("\\s+", " ")
            .trim();
}

/*
 * Tokenize the sentence and remove stop words.
 */
private List<String> tokenize(String text) {

    String normalized = normalize(text);

    if (normalized.isEmpty()) {
        return new ArrayList<>();
    }

    String[] words = normalized.split("\\s+");

    List<String> tokens = new ArrayList<>();

    for (String word : words) {

        if (!stopWords.contains(word) && word.length() > 1) {
            tokens.add(word);
        }
    }

    return tokens;
}

/*
 * Find the intent with the highest keyword score.
 */
private String detectIntent(List<String> tokens) {

    String bestIntent = null;
    int highestScore = 0;

    for (Map.Entry<String, List<String>> entry
            : keywords.entrySet()) {

        int score = 0;

        for (String token : tokens) {

            for (String keyword : entry.getValue()) {

                if (token.equals(keyword)) {
                    score++;
                }
            }
        }

        if (score > highestScore) {
            highestScore = score;
            bestIntent = entry.getKey();
        }
    }

    return bestIntent;
}

/*
 * Main method used by the GUI.
 */
public String getResponse(String userMessage) {

    if (userMessage == null ||
            userMessage.trim().isEmpty()) {

        return "Please type a question. I can help with "
                + "education, exams, programming, Java, Python, "
                + "algorithms, projects, and careers.";
    }

    List<String> tokens = tokenize(userMessage);

    if (tokens.isEmpty()) {

        return "I could not understand the question. "
                + "Please try asking an education-related question.";
    }

    String intent = detectIntent(tokens);

    if (intent == null) {

        return "I'm not sure I understand that question. "
                + "Try asking about studying, exams, programming, "
                + "Java, Python, databases, algorithms, projects, "
                + "college, or careers.";
    }

    return responses.get(intent);
}
